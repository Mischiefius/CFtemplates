[
  {
    "name" : "cpp",
    "template" : "tmpls/.template.cpp",
    "compile-command" : "g++ $ANS_FILE -std=c++20 -Wall -Wextra -fsanitize=undefined,address -Wno-sign-compare -DLOCAL $ARGS",
    "run-command" : "./a.out < $TEST_FILE > $OUT_FILE",
    "clean-command" : "rm a.out"
  },
  {
    "name" : "py",
    "template" : "tmpls/.template.py",
    "compile-command" : ":",
    "run-command" : "python $ANS_FILE < $TEST_FILE > $OUT_FILE",
    "clean-command" : ":"
  }
]
