#! /usr/bin/python3
import sys,os,subprocess,json
required_dirs = {
    '.archive',
    '.store',
    'extras'
}
ignore_dirs = {
    os.path.basename(__file__),
    '.git',
    '.gitignore',
    '.clangd',
}
commands = {}
dash = '-'*16

def command(helptext=""):
    def wrap(func):
        func.helptext = helptext
        assert commands.get(func.__name__) is None
        commands[func.__name__] = func
        return func
    return wrap

def nl_input(*prompts):
    s = ''
    while s=='': s = input(*prompts).strip()
    return s

def get_or_input(*prompts):
    if len(fields):
        return fields.pop()
    return nl_input(*prompts)

def get_or_default(default):
    global fields
    if len(fields):
        return fields.pop()
    return default
    
def read_state():
    with open('.cfd','r') as f:
        return json.load(f)

def write_state(state):
    with open('.cfd','w') as f:
        json.dump(state,f,indent=2)

def get_lang(target):
    with open('extras/langs.json','r') as f:
        for lang in json.load(f):
            if lang['name']==target: return lang
    raise ValueError(f"Language '{target}' not found in extras/langs.json")

def clear_uc(state):
    dirs = [d for d in os.listdir('.') if d not in ignore_dirs]
    print('Deleting entries from task \''+state['name']+'\'')
    print(*dirs)
    if 'tests' in dirs : dirs.remove('tests')
    subprocess.run(['rm']+dirs)
    subprocess.run(['rm','-r','tests'] )
    return True

def store_uc(state):
    path = '.store/'+state['name']
    if os.path.exists(path):
        print('Entry with name \''+path+'\' already exists')
        return False
    else: 
        dirs = [d for d in os.listdir('.') if d not in ignore_dirs]
        subprocess.run(['mkdir',path])
        subprocess.run(['mv']+dirs+[path])
        return True
        
def check_active():
    if os.path.exists('.cfd'):
        return read_state()
    else:
        print('Currently not working on anything')
        return None
        
def try_make_inactive():
    if os.path.exists('.cfd'):
        state = read_state()
        print('Already working on \''+state['name']+'\'')
        r = nl_input('Clear[c] or Store[s] or Abort[_] : ')
        if r=='c':
            return clear_uc(state)
        elif r=='s':
            return store_uc(state)
        else : return False
    else : return True

@command("new [name] [lang] [ansfile]")
def new():
    """
    Start a new task. Creates a 'tests/' directory, and an
    answer file from the language template (or empty if none).
    If another task is active, prompts to clear/store/abort first.
    """
    if not try_make_inactive(): return
    state = {}
    state['name'] = get_or_input('Name of task : ')
    state['lang'] = get_or_input('Language [py|cpp|..] : ')
    state['ansfile'] = get_or_default('ans.'+state['lang'])
    write_state(state)
    subprocess.run(['mkdir','tests'])
    if (lang:=get_lang(state['lang']))!=None:
        subprocess.run(['cp',lang['template'],state['ansfile']])
    else:
        with open(state['ansfile'],'w') as _ : pass        

@command("addtest")
def addtest():
    """
    Reads input from stdin and saves it as a new numbered test case
    in 'tests/'. File is named <n>.txt.
    """
    if (_:=check_active())==None : return
    n = len(os.listdir('tests'))
    test = sys.stdin.read()
    with open('tests/'+str(n+1)+'.txt','w') as f:
        f.write(test)

@command("clear")
def clear():
    """
    Clears the current task, if currently working on one.
    Deletes all files and directories of the current task.
    """
    if (state:=check_active())==None : return
    clear_uc(state)

@command("set attr=val ...")
def set():
    """
    Update fields in the current task’s state (.cfd).
    Example: set ansfile=main.cpp
    """
    if (state:=check_active())==None : return
    for field in fields:
        attr,val = field.split('=')
        if state.get(attr)!=None and val!='':
            print(attr,':',state[attr],'->',val)
            state[attr] = val
    write_state(state)

@command("store")
def store():
    """
    Moves the current task’s files into '.store/<taskname>/'
    and marks it inactive. Useful for pausing a task.
    """
    if (state:=check_active())==None : return
    store_uc(state)

@command("run [args]")
def run():
    """
    Compiles (if needed) and runs the answer file using the
    language commands from extras/langs.json. Runs against all
    tests in 'tests/' if present, or directly otherwise.
    """
    if (state:=check_active())==None : return
    lang = get_lang(state['lang'])
    env = os.environ.copy()
    env['ARGS'] = get_or_default('')
    env['ANSFILE'] = state['ansfile']
    result = subprocess.run(lang['comp-cmd'],shell=True,env=env)
    if result.returncode!=0: return

    tests = os.listdir('tests')
    tests.sort()
    if len(tests)==0:
        subprocess.run(lang['run-cmd'],env=env,shell=True)
        subprocess.run(lang['clean-cmd'],env=env,shell=True)
        return 
    for test in tests:
        print(dash*2,test,dash*2)
        with open('tests/'+test,'r') as iff:
            result = subprocess.run(lang['run-cmd'],
                           stdout=subprocess.PIPE, stdin=iff,
                           env=env, shell=True)
            print(dash,'O',dash*2,'O',dash)
            print(result.stdout.decode('utf-8'),end='')
    subprocess.run(lang['clean-cmd'],env=env,shell=True)

@command("archive")
def archive():
    """
    Moves the answer file into '.archive/' with a unique name
    'taskname_ansfile' and clears the rest of the task’s files.
    """
    if (state:=check_active())==None : return
    entry = state['name']+'_'+state['ansfile']
    if os.path.exists('.archive/'+entry):
        print('Entry with name \''+entry+'\' already exists')
    else:
        subprocess.run(['mv',state['ansfile'],'.archive/'+entry])
        clear_uc(state)

@command("extract [name]")
def extract():
    """
    Restores a stored task from '.store/<name>/'.
    If another task is active, prompts to clear/store/abort first.
    """
    name = get_or_input('Name of entry to extract : ')
    path = '.store/'+name+'/'
    if os.path.exists(path):
        if not try_make_inactive(): return
        dirs = [path+dir for dir in os.listdir(path)]
        subprocess.run(['mv']+dirs+['./'])
        subprocess.run(['rmdir',path])
    else:
        print('No entry with name \''+name+'\' in store')

@command("help [command] ...")
def help():
    """
    Gee I wonder what this command does?
    Optionally provide command names to see details only for those.
    """
    # ANSI colors
    CYAN = "\033[96m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RESET = "\033[0m"

    print_commands = commands if not fields else {}
    while fields:
        cmd_name = fields.pop()
        print_commands[cmd_name] = commands.get(cmd_name)

    for name, func in sorted(print_commands.items()):
        if func is None:
            print(f"\n{YELLOW}No such command:{RESET} {CYAN}{name}{RESET}")
            continue
        usage = getattr(func, "helptext", "")
        desc = func.__doc__.strip()
        print(f"\n{CYAN}{name}{RESET}")
        if usage:
            print(f"  {GREEN}Usage:{RESET} {usage}")
        for line in desc.splitlines():
            print(f"    {line.lstrip()}")

#---------------------------entry_point---------------------------#
for dir in required_dirs:
    assert os.path.exists(dir)

ignore_dirs.update(required_dirs)

if len(sys.argv)>=2 and sys.argv[1] in commands:
    fields = sys.argv[2:][::-1]
    commands[sys.argv[1]]()
else:
    print(f"\033[91mInvalid command : \033[0m\033[96m{sys.argv[1]}\033[0m")
    print("Run '\033[96m./cf help\033[0m' to see the list of available commands.")
